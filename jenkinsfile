pipeline {
     agent{
        label 'docker'
     }
     stages {
        stage('Build Docker image') {
            steps {
                script {
                    sh 'docker build -t mohamedsohiel/docker -react -f Dockerfile.dev'
                }
            }
        }
        stage ('Run Test') {
            steps {
                script {
                    env.DOCKER_BUILDKIT = 1
                    sh 'docker run -e CI=true mohamedsohiel/docker-react npm test'
                }
            }
        }
     }

}